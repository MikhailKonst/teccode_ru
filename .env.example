# ─── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://teccode:teccode@localhost:5432/teccode"

# ─── Администратор (обязательно) ─────────────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your_strong_password_here

# ─── Сервер ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# В продакшене: если за reverse-proxy (nginx, Traefik) — раскомментировать
# TRUST_PROXY=1

# HTTPS strict transport (включить только за TLS-терминатором)
# HSTS=1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Оставить пустым чтобы CORS был отключён (SPA и API на одном домене/порту)
# Явный список для раздельного деплоя:
# CORS_ORIGIN=https://your-domain.com

# ─── Email ────────────────────────────────────────────────────────────────────
# Если не задано — форма сохраняет заявки в БД, но не отправляет письмо.
#
# Яндекс 360 (рекомендуется для teccode.ru):
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465          (SSL) или 587 (STARTTLS)
#   SMTP_USER=info@teccode.ru
#   SMTP_PASS=<пароль приложения из Яндекс ID>
#
# Mail.ru для бизнеса:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
#   SMTP_USER=info@teccode.ru
#   SMTP_PASS=<пароль>

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@teccode.ru
SMTP_PASS=your_app_password_here
SMTP_FROM="TechCode <info@teccode.ru>"

# Куда отправлять заявки (по умолчанию уже правильно):
MAIL_TO_ORDERS=info@teccode.ru
MAIL_TO_SUPPORT=support@teccode.ru
